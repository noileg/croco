# クロコ設定ファイルの雛形
#
# このファイルをコピーして %USERPROFILE%\.croco\.env に置く。
# プロジェクトフォルダの外に置くのは仕様書2章-7の方針
# （平文の秘密情報をプロジェクト内に置かない）。
#
#   mkdir %USERPROFILE%\.croco
#   copy .env.example %USERPROFILE%\.croco\.env

# --- 認証情報（必須） ---------------------------------------------------

# Notion Integration のトークン（https://www.notion.so/my-integrations）
# 接続先は Inbox DB と置き場ページだけに絞ること（仕様書2.5章-12）
NOTION_TOKEN=

# Gemini API キー（https://aistudio.google.com/apikey）
GEMINI_API_KEY=

# --- Notion側の実体（setup_notion.py が出力する値を貼る） ----------------

NOTION_UNPROCESSED_PAGE_ID=
NOTION_PROCESSED_PAGE_ID=
NOTION_INBOX_DATABASE_ID=
NOTION_INBOX_DATA_SOURCE_ID=

# --- 任意（既定値のままで動く） ------------------------------------------

# 使用モデル。精度不足を感じたら gemini-3.1-pro 等に上げる
#GEMINI_MODEL=gemini-3.6-flash

# 分割・転記に深い推論は不要（minimal / low / medium / high）
#GEMINI_THINKING_LEVEL=minimal

# 抽出タスクなので低め
#GEMINI_TEMPERATURE=0.1

# Move Page API が使えるバージョン以上であること
#NOTION_VERSION=2026-03-11

# 同一アイテムの再試行上限。超えたら「要確認」に落とす
#CROCO_MAX_RETRIES=3

# クロコが実装するプロジェクトの置き場（既定: クロコ関係\クロコ管轄プロジェクト）
#CROCO_PROJECTS_DIR=

# claude 実行ファイルの名前かフルパス
# スタートアップ起動でも確実にするため、フルパスの指定を推奨
#CROCO_CLAUDE_COMMAND=claude

# クロコを対話モードで起動するか（既定：する）
# 対話だと途中で軌道修正できる。0 にすると非対話（claude -p）になる
#CROCO_INTERACTIVE=1

# 着手アイテムが複数あるときに選ぶ猶予（秒）。0 で常に自動選択
#CROCO_PICK_TIMEOUT=60
