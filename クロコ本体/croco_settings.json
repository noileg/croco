{
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Bash(git push --force*)",
      "PowerShell(git push --force*)",
      "Bash(git push -f*)",
      "PowerShell(git push -f*)",
      "Bash(git push --mirror*)",
      "PowerShell(git push --mirror*)",
      "Bash(git push --delete*)",
      "PowerShell(git push --delete*)",
      "Bash(git reset --hard*)",
      "PowerShell(git reset --hard*)",
      "Bash(git clean -fdx*)",
      "PowerShell(git clean -fdx*)",
      "Bash(git filter-branch*)",
      "PowerShell(git filter-branch*)",
      "Bash(git update-ref -d*)",
      "PowerShell(git update-ref -d*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -fr /*)",
      "Bash(rmdir /s*)",
      "PowerShell(rmdir /s*)",
      "Bash(del /s*)",
      "PowerShell(del /s*)",
      "Bash(format *)",
      "PowerShell(format *)",
      "PowerShell(Remove-Item -Recurse -Force*)",
      "PowerShell(rm -Recurse -Force*)",
      "PowerShell(ri -Recurse -Force*)",
      "Read(**/.croco/**)",
      "Edit(**/.croco/**)",
      "Read(**/.env)",
      "Edit(**/.env)",
      "Edit(**/クロコ本体/**)",
      "Edit(**/下書き/**)",
      "Bash(*pythonw*)",
      "PowerShell(*pythonw*)",
      "Edit(**/.claude/**)",
      "Edit(**/.ssh/**)",
      "Read(**/.ssh/**)",
      "Edit(**/AppData/**)",
      "Edit(C:/Windows/**)",
      "Bash(npm publish*)",
      "PowerShell(npm publish*)",
      "Bash(twine upload*)",
      "PowerShell(twine upload*)",
      "Bash(git push*)",
      "PowerShell(git push*)",
      "Bash(gh *)",
      "PowerShell(gh *)",
      "Bash(git remote set-url*)",
      "PowerShell(git remote set-url*)",
      "Bash(git remote add*)",
      "PowerShell(git remote add*)",
      "Bash(icacls *)",
      "PowerShell(icacls *)",
      "Bash(takeown *)",
      "PowerShell(takeown *)",
      "Bash(reg add *)",
      "PowerShell(reg add *)",
      "Bash(reg delete *)",
      "PowerShell(reg delete *)",
      "Bash(schtasks *)",
      "PowerShell(schtasks *)",
      "Bash(shutdown *)",
      "PowerShell(shutdown *)"
    ],
    "allow": [
      "Bash(python *croco_cli.py*)",
      "Bash(python *catalog_cli.py*)"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-c",
              "import os,winsound\nif os.environ.get(\"CROCO_NOTIFY\",\"1\") not in (\"0\",\"false\",\"no\"): winsound.Beep(880,110); winsound.Beep(1175,130)"
            ],
            "async": true,
            "timeout": 5
          }
        ]
      }
    ]
  }
}
